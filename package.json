{
  "name": "generator-jhipster-migrate",
  "version": "1.9.0",
  "description": "Migrate Project",
  "keywords": [
    "yeoman-generator",
    "jhipster-blueprint",
    "jhipster-9"
  ],
  "homepage": "https://github.com/jhipster/generator-jhipster-migrate#readme",
  "bugs": {
    "url": "https://github.com/jhipster/generator-jhipster-migrate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhipster/generator-jhipster-migrate.git"
  },
  "license": "MIT",
  "author": "Marcelo Shima <marceloshima@gmail.com>",
  "type": "module",
  "bin": {
    "jhipster-migrate": "cli/cli.cjs"
  },
  "files": [
    "cli",
    "generators",
    "!**/__*",
    "!**/*.snap",
    "!**/*.spec.?(c|m)?(j|t)s"
  ],
  "scripts": {
    "ejslint": "ejslint generators/**/*.ejs",
    "lint": "eslint",
    "lint-fix": "npm run lint -- --fix",
    "prepare": "husky",
    "prettier-check": "prettier --check \"{,**/}*.{md,json,yml,html,cjs,mjs,js,cts,mts,ts,tsx,css,scss,vue,java}\"",
    "prettier-format": "prettier --write \"{,**/}*.{md,json,yml,html,cjs,mjs,js,cts,mts,ts,tsx,css,scss,vue,java}\"",
    "pretest": "npm run prettier-check && npm run lint",
    "test": "vitest run",
    "update-snapshot": "vitest run --update",
    "vitest": "vitest"
  },
  "dependencies": {
    "@yeoman/namespace": "^2.1.0",
    "chalk": "^5.3.0",
    "get-node": "^15.0.0",
    "globby": "^14.0.1",
    "latest-version": "^9.0.0",
    "mem-fs": "^4.1.4 || ^6.0.0",
    "mem-fs-editor": "^12.0.3",
    "ora": "^9.4.1",
    "p-transform": "^5.0.1",
    "parse-gitignore": "^2.0.0",
    "pkg-versions": "^4.0.0",
    "readable-stream": "^4.5.2",
    "semver": "^7.6.0",
    "simple-git": "^3.23.0",
    "untildify": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.3",
    "ejs-lint": "2.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "generator-jhipster": "9.4.0",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "^15.2.2",
    "lodash-es": "^4.17.21",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "vitest": "5.0.0",
    "yeoman-assert": "^3.1.1",
    "yeoman-test": ">=10"
  },
  "peerDependencies": {
    "generator-jhipster": "^9.0.0"
  },
  "engines": {
    "generator-jhipster": "^9.0.0",
    "node": "^22.18.0 || >=24.11.0"
  },
  "cacheDirectories": [
    "node_modules"
  ]
}
